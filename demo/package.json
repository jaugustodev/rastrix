{
  "name": "rastrix-demo",
  "version": "0.1.0",
   "private": true,
  "description": "Sample Node.js + TypeScript + Express API that breaks on purpose, so you can see the Rastrix agent find the root cause of incidents.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:debug": "tsx watch --inspect src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rastrix",
    "demo",
    "express",
    "typescript",
    "incident",
    "root-cause-analysis",
    "observability"
  ],
  "author": "João Augusto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaugustodev/rastrix.git",
    "directory": "demo"
  },
  "homepage": "https://github.com/jaugustodev/rastrix#readme",
  "bugs": {
    "url": "https://github.com/jaugustodev/rastrix/issues"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
